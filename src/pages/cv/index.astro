---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cvData } from '../../data/cv';
import { profile } from '../../data/profile';
import { getCollection } from 'astro:content';
import { toUrl } from '../../utils/paths';

const pubs = await getCollection('publications');
pubs.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const isSelf = (author: string) => author.toLowerCase().includes('mutalib');
---

<BaseLayout
  title="Curriculum Vitae"
  description="Academic Curriculum Vitae of Md Abdul Mutalib — Education, Bio-Computing Research at HITSZ, Publications, Awards, and Technical Proficiencies."
>
  <div class="container">
    <header style="margin-bottom: 2rem;">
      <h1 style="margin-bottom: 0.5rem;">Curriculum Vitae</h1>
      <p style="font-size: 1.05rem; color: var(--text-secondary); margin: 0; line-height: 1.6;">
        {cvData.summary}
      </p>
    </header>

    <!-- Download PDF Box -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-left: 4px solid var(--accent-teal); border-radius: var(--radius-md); padding: 1.25rem 1.5rem; margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <strong style="display: block; font-size: 1.05rem; color: var(--text-primary); margin-bottom: 0.2rem;">Official Academic CV (PDF)</strong>
        <span style="font-size: 0.9rem; color: var(--text-secondary); display: block; max-width: 620px;">
          Download the latest comprehensive CV covering graduate research at HITSZ, publications, presentations, and certifications.
        </span>
      </div>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href={toUrl('/downloads/Md_Abdul_Mutalib_CV.pdf')} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <span>📄 View / Open CV (PDF)</span>
        </a>
        <a href={`mailto:${profile.email}?subject=Academic%20Inquiry%20-%20Md%20Abdul%20Mutalib`} class="btn-secondary">
          <span>✉️ Contact via Email</span>
        </a>
      </div>
    </div>

    <!-- Education Section -->
    <section class="cv-section" id="education" aria-label="Education">
      <h2>Education</h2>
      {cvData.education.map((edu) => (
        <div class="cv-entry">
          <div class="cv-entry-header">
            <h3 class="cv-title">{edu.degree} in {edu.field}</h3>
            <span class="cv-period">{edu.period}</span>
          </div>
          <div class="cv-subtitle">
            {edu.institution} &bull; {edu.location}
            {edu.gpa && (
              <span style="font-size: 0.88rem; font-weight: 600; color: var(--accent-teal); margin-left: 0.5rem;">
                (GPA: {edu.gpa})
              </span>
            )}
            {edu.scholarship && (
              <span class="pub-badge" style="margin-left: 0.5rem; vertical-align: middle;">
                {edu.scholarship}
              </span>
            )}
          </div>
          {edu.details && (
            <ul class="cv-list">
              {edu.details.map((d) => <li>{d}</li>)}
            </ul>
          )}
        </div>
      ))}
    </section>

    <!-- Awards & Honors -->
    <section class="cv-section" aria-label="Awards and Honors">
      <h2>Awards & Honors</h2>
      <div style="display: flex; flex-direction: column; gap: 0.85rem; margin-top: 1rem;">
        {cvData.awards.map((award) => (
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.85rem 1.15rem; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem;">
            <div>
              <strong style="font-size: 0.98rem; color: var(--text-primary);">{award.title}</strong>
              <span style="display: block; font-size: 0.88rem; color: var(--text-secondary); margin-top: 0.15rem;">
                {award.organization}
              </span>
            </div>
            <span style="font-size: 0.85rem; font-weight: 600; color: var(--accent-teal);">{award.year}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Research Experience -->
    <section class="cv-section" aria-label="Research Experience">
      <h2>Research Experience</h2>
      {cvData.experience.filter((e) => e.category === 'research').map((exp) => (
        <div class="cv-entry">
          <div class="cv-entry-header">
            <h3 class="cv-title">{exp.role}</h3>
            <span class="cv-period">{exp.period}</span>
          </div>
          <div class="cv-subtitle">
            {exp.organization} &bull; {exp.location}
            {exp.project && ` — Project: "${exp.project}"`}
          </div>
          <ul class="cv-list">
            {exp.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <!-- Publications from Content Collection -->
    <section class="cv-section" aria-label="Publications">
      <h2>Publications & Preprints</h2>
      <ol style="padding-left: 1.25rem; margin-top: 1rem;">
        {pubs.map((pub) => (
          <li style="margin-bottom: 1rem; line-height: 1.55; font-size: 0.95rem;">
            <span>
              {pub.data.authors.map((a, i) => (
                <>
                  {isSelf(a) ? <strong class="author-self">{a}</strong> : a}
                  {i < pub.data.authors.length - 1 ? ', ' : ''}
                </>
              ))}
            </span>
            <span> ({pub.data.year}). </span>
            <a href={toUrl(`/publication/${pub.id.replace(/\.md$/, '')}/`)} style="font-weight: 600;">
              "{pub.data.title}"
            </a>
            <span>. <em>{pub.data.venue}</em></span>
            {pub.data.volume && <span>, Vol. {pub.data.volume}</span>}
            {pub.data.issue && <span>({pub.data.issue})</span>}
            {pub.data.pages && <span>, pp. {pub.data.pages}</span>}
            {pub.data.doi ? (
              <span>. DOI: <a href={pub.data.publisherUrl || `https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer">{pub.data.doi}</a></span>
            ) : pub.data.publisherUrl ? (
              <span>. <a href={pub.data.publisherUrl} target="_blank" rel="noopener noreferrer">Publisher Link</a></span>
            ) : null}
          </li>
        ))}
      </ol>
    </section>

    <!-- Conference Presentations & Posters -->
    <section class="cv-section" aria-label="Conference Presentations and Posters">
      <h2>Conference Presentations & Posters</h2>
      <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
        {cvData.presentations.map((pres) => (
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.35rem;">
              <strong style="font-size: 0.98rem; color: var(--text-primary);">{pres.title}</strong>
              <span style="font-size: 0.85rem; font-weight: 600; color: var(--accent-teal);">{pres.year}</span>
            </div>
            <div style="font-size: 0.9rem; color: var(--text-secondary);">
              <em>{pres.event}</em> &bull; {pres.location}
              <span class="pub-badge" style="margin-left: 0.5rem;">{pres.role}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Professional & Leadership Experience -->
    <section class="cv-section" aria-label="Professional and Leadership Experience">
      <h2>Professional & Leadership Experience</h2>
      {cvData.experience.filter((e) => e.category !== 'research').map((exp) => (
        <div class="cv-entry">
          <div class="cv-entry-header">
            <h3 class="cv-title">{exp.role}</h3>
            <span class="cv-period">{exp.period}</span>
          </div>
          <div class="cv-subtitle">{exp.organization} &bull; {exp.location}</div>
          <ul class="cv-list">
            {exp.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <!-- Technical Proficiencies & Skills -->
    <section class="cv-section" aria-label="Skills & Proficiencies">
      <h2>Technical Proficiencies & Tooling</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-top: 1rem;">
        {cvData.skills.map((s) => (
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem;">
            <strong style="display: block; font-size: 0.98rem; margin-bottom: 0.5rem; color: var(--accent-teal);">
              {s.category}
            </strong>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
              {s.items.map((item) => (
                <span class="pub-topic-tag" style="font-size: 0.82rem;">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications & Specialized Training -->
    <section class="cv-section" aria-label="Certifications & Training">
      <h2>Certifications & Specialized Training</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-top: 1rem;">
        {cvData.certifications.map((c) => (
          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.9rem 1.15rem;">
            <strong style="display: block; font-size: 0.95rem; color: var(--text-primary);">{c.title}</strong>
            <span style="display: block; font-size: 0.85rem; color: var(--text-secondary); margin-top: 0.2rem;">
              {c.issuer} &bull; <span style="color: var(--accent-teal); font-weight: 500;">{c.date}</span>
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- Extracurricular & Volunteer Leadership -->
    <section class="cv-section" aria-label="Extracurricular Leadership">
      <h2>Extracurricular Leadership & Community Service</h2>
      {cvData.extracurricular.map((item) => (
        <div class="cv-entry">
          <div class="cv-entry-header">
            <h3 class="cv-title">{item.role}</h3>
            <span class="cv-period">{item.period}</span>
          </div>
          <div class="cv-subtitle">{item.organization} &bull; {item.location}</div>
          <ul class="cv-list">
            {item.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>
