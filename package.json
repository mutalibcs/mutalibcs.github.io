  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --import tsx scripts/generate_redirects.ts && astro build && cp dist/sitemap-0.xml dist/sitemap.xml",
